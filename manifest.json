{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "css": [
        "content.css"
      ],
      "js": [
        "data/wordlists.js",
        "content.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "按你的英语水平（小学/初中/高中/四级/六级）自动把网页生词标黄，悬停看音标和中文释义；没查看的词默认你会了；支持划词划句解释，API 地址和模型可灵活配置。",
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://*/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "英语生词高亮助手 - Vocab Highlighter",
  "options_page": "options.html",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "version": "1.1.3"
}